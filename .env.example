# ---------------------------------------------------------------------------
# Rachna AI — environment
# Copy to .env.local and edit. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# The origin a CUSTOMER'S PHONE will use. This is what goes inside the QR code.
#
# It must be reachable from the public internet. A QR containing localhost or a
# 192.168.x.x address is unscannable from mobile data — it will look like it
# works right up until a customer points a phone at it.
#
# Development (Cloudflare Quick Tunnel prints this URL when it starts):
#   NEXT_PUBLIC_APP_URL=https://something-random-words.trycloudflare.com
#
# Production:
#   NEXT_PUBLIC_APP_URL=https://app.rachna.ai
NEXT_PUBLIC_APP_URL=

# How long a customer link stays open, in hours. Two to three days (§5).
CUSTOMER_SESSION_DURATION_HOURS=72

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development uses PGlite — real PostgreSQL, persisted to .data/pgdata. No
# server, no credentials.
# PGLITE_DATA_DIR=.data/pgdata

# To move to Supabase or any hosted Postgres, set this and swap the driver in
# src/db/index.ts. The schema and migrations are unchanged.
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Project photographs are written here, outside public/, and served through
# /api/images/[id]. Replace src/server/storage.ts to use Supabase Storage.
# UPLOAD_DIR=.data/uploads

# ---------------------------------------------------------------------------
# AI (not required — the deterministic path runs without any of these)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
